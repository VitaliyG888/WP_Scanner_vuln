{
  "description": "Ground truth for the intentionally vulnerable WordPress lab plugin. Tests assert that the scanner detects every category listed here.",
  "plugin": "env/vulnerable-plugin/vuln-core.php",
  "clean_sample": {
    "path": "env/clean-sample/safe-code.php",
    "expected_findings": 0,
    "comment": "Precision baseline: properly sanitised WordPress code must produce no findings."
  },
  "static_expected_any_of": [
    ["sqli-wpdb-interpolation"],
    ["rce-command-injection"],
    ["upload-unrestricted"],
    ["lfi-arbitrary-file-read"],
    ["deserialization-untrusted"],
    ["xss-unescaped-output"],
    ["redirect-open"],
    ["weak-password-hash"],
    ["secret-api-key", "secret-db-credentials"],
    ["unauth-ajax-action"]
  ],
  "static_expected_categories": [
    "sqli",
    "rce",
    "file_upload",
    "lfi",
    "deserialization",
    "xss",
    "open_redirect",
    "weak_hash",
    "hardcoded_secret",
    "unauth_action"
  ],
  "dynamic_required_any_of": [
    ["command-injection"],
    ["sqli-error", "sqli-blind"],
    ["lfi"],
    ["file-upload-rce"],
    ["reflected-xss"],
    ["open-redirect"],
    ["deserialization"]
  ],
  "dynamic_optional_any_of": [
    ["xmlrpc"],
    ["user-enum-rest", "user-enum-author"],
    ["sensitive-file"],
    ["directory-listing"]
  ],
  "static_min_findings": 15
}
